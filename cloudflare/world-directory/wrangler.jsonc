{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dragonwilds-sync-directory",
  "main": "src/public-directory-entry.ts",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "vars": {
    "OFFLINE_AFTER_SECONDS": "1800",
    "HISTORY_RETENTION_DAYS": "7",
    "PUBLIC_SOURCE_REFRESH_SECONDS": "1800",
    "PUBLIC_SOURCE_MAX_SERVERS": "500",
    "PUBLIC_SOURCE_BATCH_PAGES": "35",
    "PUBLIC_SOURCE_PROVIDERS": "shrug,lobbysup",
    "PUBLIC_SOURCE_TIMEOUT_MS": "5000"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dragonwilds-sync-worlds",
      "database_id": "c4498761-2e93-47e4-a7f2-d7a572293ffd",
      "migrations_dir": "migrations"
    }
  ]
}
