{
  "schema": "DragonwildsSync.SystemMap.v2",
  "branch": "main",
  "version_authority": ["package.json", "package-lock.json", "renderer/release-meta.js", "RELEASE.txt"],
  "inventory": "docs/SYSTEMS.md",
  "test_matrix": "docs/test-matrix.json",
  "authorities": {
    "desktop_lifecycle": "electron/main.cjs + electron/main-v2.cjs",
    "renderer_boundary": "electron/preload-v2.cjs (live sandbox preload); electron/preload.cjs (historical compatibility alias)",
    "trusted_core": "backend/dragonwilds_service.py",
    "desired_state": "backend/profile_store.py + backend/profile_settings.py",
    "secrets": "backend/secret_store.py",
    "runtime_policy": "backend/runtime_manager.py",
    "runtime_materialization": "backend/server_engine.py",
    "world_execution": "backend/runtime_worker.py + backend/worker_supervisor.py",
    "feature_execution": "backend/feature_worker.py + backend/feature_worker_supervisor.py",
    "client_sync": "backend/sync_engine.py + backend/phase6_integration.py",
    "public_directory": "backend world-directory modules + cloudflare/dragonwilds-sync-directory",
    "test_evidence": "scripts/run_system_tests.py"
  },
  "state_layers": ["desired", "managed_appdata", "materialized_runtime", "live_applied"],
  "security_invariants": {
    "secret_reference_prefix": "dws-secret://",
    "public_fields": "allowlist_only",
    "server_mods_txt_to_client": "forbidden",
    "renderer_direct_core_access": "forbidden",
    "worker_durable_profile_authority": "forbidden"
  },
  "release_rule": "all required_for_release matrix cases pass for the exact artifact or have an approved waiver"
}
